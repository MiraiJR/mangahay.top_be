{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2017",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "paths": {
      "@common/*": ["src/common/*"],
      "@core/*": ["src/core/*"],
      "@modules/*": ["src/modules/*"],
      "@app/*": ["src/app/*"],
      "@module/comic": ["src/modules/comic"],
      "@module/user-setting": ["src/modules/user-setting"],
      "@module/user": ["src/modules/user"],
      "@module/comment": ["src/modules/comment"],
      "@module/auth": ["src/modules/auth"],
      "@module/chapter": ["src/modules/chapter"],
      "@module/notification": ["src/modules/notification"],
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
